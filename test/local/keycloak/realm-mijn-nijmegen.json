{
  "realm": "mijn-nijmegen",
  "displayName": "Mijn Nijmegen - lokale DigiD/eHerkenning mock",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "browserFlow": "browser-without-sso",
  "authenticationFlows": [
    {
      "alias": "browser-without-sso",
      "description": "Browser flow without the SSO cookie check: always ask for username and password, like DigiD and eHerkenning",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "basic"
  ],
  "defaultOptionalClientScopes": [],
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "auth_time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "AUTH_TIME",
            "claim.name": "auth_time",
            "jsonType.label": "long",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "digid",
      "protocol": "openid-connect",
      "description": "DigiD mock. The BSN is the sub claim, which is the Keycloak user id.",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "eherkenning",
      "protocol": "openid-connect",
      "description": "eHerkenning mock. KvK number and company name from user attributes.",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "kvk",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "kvk",
            "claim.name": "urn:etoegang:1\\.9:EntityConcernedID:KvKnr",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "company name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "companyName",
            "claim.name": "urn:etoegang:1\\.11:attribute-represented:CompanyName",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "mijn-nijmegen",
      "name": "Mijn Nijmegen (lokaal)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "local-dev-oidc-client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/auth"
      ],
      "webOrigins": [],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic"
      ],
      "optionalClientScopes": [
        "digid",
        "eherkenning"
      ]
    }
  ],
  "users": [
    {
