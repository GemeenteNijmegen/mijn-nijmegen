{{>header}}

<main>
    <div class="container">
        {{>breadcrumbs}}
        <div class="row">
            {{>sidenav}}
            <div class="col-lg-9 col-md-12">
                <h1>{{title}}</h1>
                
                <p class="lead">We hebben een verificatiecode gestuurd naar <strong>{{pendingValue}}</strong>.</p>
                
                {{#error}}
                <div class="alert alert-danger">{{error}}</div>
                {{/error}}

                <form method="POST" action="/persoonsgegevens/verify" novalidate>
                    <input type="hidden" name="xsrf_token" value="{{xsrf_token}}">
                    <input type="hidden" name="type" value="{{type}}">
                    
                    <div class="md-form">
                        <label for="code">Verificatiecode</label>
                        <input type="text" id="code" name="code" class="form-control" required pattern="[0-9]{6}" maxlength="6" autocomplete="off">
                        <div class="invalid-feedback">
                            <span class="sr-only">Invoer onjuist: </span>Vul een geldige 6-cijferige code in
                        </div>
                        <small class="form-text text-muted">Voer de 6-cijferige code in die u heeft ontvangen.</small>
                    </div>
                    
                    <button type="submit" class="btn btn-primary">Verifiëren</button>
                    <a href="/persoonsgegevens" class="btn btn-secondary">Annuleren</a>
                </form>
                
                <p class="mt-3"><small>De code is 15 minuten geldig. U heeft nog {{attemptsLeft}} poging(en) over.</small></p>
            </div>
        </div>
    </div>
</main>

<script src="/static/js/form-validation.js"></script>
{{>footer}}
