{{>header}}
<main>
    <!-- START: template component(s) -->
    <div class="container">
        <div class="row">
        <nav class="nijmegen-sidenav col-lg-3 col-md-12">
                <ul class="nijmegen-sidenav__list">
                {{#nav}}
                    <li class="nijmegen-sidenav__item {{#current}}active{{/current}}">
                        {{{icon}}}
                        <a href="{{{url}}}">{{title}}</a>
                    </li>
                {{/nav}}
                </ul>
        </nav>
        <div class="col-lg-9 col-md-12">
                <h1>Mijn Contactgegevens</h1>
                {{^error}}

                <form method="post">

                    <div class="md-form">
                        <label for="email">E-mailadres</label>
                        <input type="text" id="email" name="email" autocomplete="email" class="form-control {{#emailError}}is-invalid{{/emailError}}" value="{{email}}">
                    </div>

                    <div class="md-form">
                        <label for="telefoonnummer">Telefoonnummer</label>
                        <input type="text" id="telefoonnummer" name="telefoonnummer" autocomplete="tel" class="form-control {{#telefoonnummerError}}is-invalid{{/telefoonnummerError}}" value="{{telefoonnummer}}">
                    </div>


                    <div class="md-form">
                      <span>Welk kanaal heeft uw voorkeur?</span>
                      <div ref="component" class="form-group has-feedback formio-component formio-component-radio_nijmegen formio-component-selectedid" id="e5p8f8j">
                        <div class="form-radio radio">
                          <div ref="wrapper" class="form-check">
                              <input id="voorkeur-telefoon" value="telefoonnummer" class="form-check-input" type="radio" name="voorkeur">
                              <label for="voorkeur-telefoon" class="form-check-label label-position-right">Telefoon</label>
                          </div>
                          
                          <div ref="wrapper" class="form-check">
                              <input id="voorkeur-email" value="email" class="form-check-input" type="radio" name="voorkeur">
                              <label for="voorkeur-email" class="form-check-label label-position-right">E-mail</label>
                          </div>
                          
                        </div>
                    </div>


                    <input type="hidden" name="xsrf_token" value="{{xsrf_token}}"/>

                    <button type="submit" class="btn btn-primary">Wijzigingen opslaan</button>

                </form>

                {{/error}}
                {{#error}}
                    <h2>Er is iets misgegaan</h2>
                    <p>{{error}}</p>
                {{/error}}
            </div>
        </div>
    </div>

    <!-- END: template component(s) -->
</main>
{{>footer}}
