{{>header}}
<main>
    <!-- START: template component(s) -->
    <div class="container">
        <div class="row">
            <nav class="nijmegen-sidenav col-lg-3 col-md-12">
                <ul class="nijmegen-sidenav__list">
                {{#nav}}
                    <li class="nijmegen-sidenav__item {{#current}}active{{/current}}">
                        {{{icon}}}
                        <a href="{{{url}}}">{{title}}</a>
                    </li>
                {{/nav}}
                </ul>
            </nav>
            <div class="col-lg-9 col-md-12 nijmegen-theme">
                <h1>{{product.naam}}</h1>
                <p class="lead">Hier vindt u de informatie van uw {{product.producttype.uniforme_product_naam}}. U kunt deze ook inladen in uw Wallet.

                
                <div class="nijmegen-action-card">
                    <div class="nijmegen-action-card__content">
                        <h4 class="utrecht-heading-5">ID Wallet</h4>
                        {{#wallet_result.success}}
                            <p>Het inladen in de wallet is geslaagd.</p>
                        {{/wallet_result.success}}

                        {{#wallet_result.failed}}
                        <p>Het inladen in de wallet is niet gelukt. Probeer het opnieuw.</p>
                        {{/wallet_result.failed}}
                        {{^wallet_result.success}}
                        <p class="utrecht-paragraph">Plaats deze {{product.producttype.uniforme_product_naam}} in uw ID Wallet</p>
                        <p role="group" class="utrecht-button-group">
                            <a href="/producten/{{product.uuid}}?inladen_wallet=true" class="utrecht-button utrecht-button--primary-action spin" type="button">Plaats product in wallet</a>
                        </p>
                        {{/wallet_result.success}}
                    </div>
                </div>
                
                
                <h2>Informatie over uw product</h2>
                <table class="nijmegen-table nijmegen-table-full-width">
                    <thead class="nijmegen-table__header">
                        <tr class="nijmegen-table__row">
                        <th scope="col" class="nijmegen-table__header-cell">Wijk</th>
                        <th scope="col" class="nijmegen-table__header-cell">Afvalsoort</th>
                        <th scope="col" class="nijmegen-table__header-cell">Ophaaldag</th>
                        </tr>
                    </thead>
                    <tbody class="nijmegen-table__body">
                        <tr class="nijmegen-table__row">
                        <td class="nijmegen-table__data-cell" data-label="Wijk">Nijmegen-Oost</td>
                        <td class="nijmegen-table__data-cell" data-label="Afvalsoort">Restafval</td>
                        <td class="nijmegen-table__data-cell" data-label="Ophaaldag">Maandag</td>
                        </tr>
                        <tr class="nijmegen-table__row">
                        <td class="nijmegen-table__data-cell" data-label="Wijk">Dukenburg</td>
                        <td class="nijmegen-table__data-cell" data-label="Afvalsoort">Papier & karton</td>
                        <td class="nijmegen-table__data-cell" data-label="Ophaaldag">Woensdag</td>
                        </tr>
                        <tr class="nijmegen-table__row">
                        <td class="nijmegen-table__data-cell" data-label="Wijk">Lindenholt</td>
                        <td class="nijmegen-table__data-cell" data-label="Afvalsoort">GFT</td>
                        <td class="nijmegen-table__data-cell" data-label="Ophaaldag">Donderdag</td>
                        </tr>
                        <tr class="nijmegen-table__row">
                        <td class="nijmegen-table__data-cell" data-label="Wijk">Nijmegen-Noord</td>
                        <td class="nijmegen-table__data-cell" data-label="Afvalsoort">Grofvuil</td>
                        <td class="nijmegen-table__data-cell" data-label="Ophaaldag">Maandag</td>
                        </tr>
                    </tbody>
                    </table>
                <dl>
                    <dt>Status</dt>
                    <dd>{{product.status}}</dd>

                    <dt>Prijs</dt>
                    <dd>€ {{product.prijs}}</dd>

                    <dt>Geldigheid</dt>
                    <dd>{{#product.start_datum}}van {{product.start_datum}}{{/product.start_datum}}{{#product.eind_datum}} t/m {{product.eind_datum}}{{/product.eind_datum}}</dd>

                    <dt>Laatste update</dt>
                    <dd>{{product.update_datum}}</dd>

                    {{#product.dataobject.location}}
                    <dt>Locatie</dt>
                    <dd>{{product.dataobject.location}}</dd>
                    {{/product.dataobject.location}}
                </dl>

                <h2>Producttype</h2>
                <p class="lead">{{product.producttype.uniforme_product_naam}}</p>
                <dl>
                    <dt>Code</dt>
                    <dd>{{product.producttype.code}}</dd>
                    {{#product.producttype.themas}}
                    <dt>Thema</dt>
                    <dd>{{naam}}</dd>
                    {{#beschrijving}}
                    <dt>Thema omschrijving</dt>
                    <dd>{{beschrijving}}</dd>
                    {{/beschrijving}}
                    {{/product.producttype.themas}}
                </dl>

                {{#product.documenten}}
                <h2>Documenten</h2>
                <ul>
                    <li>{{.}}</li>
                </ul>
                {{/product.documenten}}

                {{#product.zaken}}
                <h2>Zaken</h2>
                <ul>
                    <li>{{.}}</li>
                </ul>
                {{/product.zaken}}

                {{#product.taken}}
                <h2>Taken</h2>
                <ul>
                    <li>{{.}}</li>
                </ul>
                {{/product.taken}}

                {{#product.aanvraag_zaak_url}}
                <h2>Aanvraag</h2>
                <dl>
                    <dt>Zaak URL</dt>
                    <dd><a href="{{product.aanvraag_zaak_url}}">{{product.aanvraag_zaak_url}}</a></dd>
                </dl>
                {{/product.aanvraag_zaak_url}}
            </div>
            </div>
        </div>
    </div>
    <!-- END: template component(s) -->
</main>
<script src="/static/js/spinner.js"></script>
{{>footer}}
