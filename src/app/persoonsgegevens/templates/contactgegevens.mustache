<section>
    <h2>Contactgegevens</h2>

    {{^errorContactgegevens}}

        <table class="nijmegen-table nijmegen-table-full-width">
            <thead class="nijmegen-table__header">
                <tr class="nijmegen-table__row">
                    <th scope="col" class="nijmegen-table__header-cell">Kenmerk</th>
                    <th scope="col" class="nijmegen-table__header-cell">Waarde</th>
                    <th scope="col" class="nijmegen-table__header-cell">Actie</th>
                </tr>
            </thead>
            <tbody class="nijmegen-table__body">
                <tr class="nijmegen-table__row">
                    <td class="nijmegen-table__data-cell" data-label="Kenmerk">E-mailadres</td>
                    <td class="nijmegen-table__data-cell" data-label="Waarde">{{email}}{{^email}}-{{/email}}</td>
                    <td class="nijmegen-table__data-cell" data-label="Actie">
                        <a href="/persoonsgegevens/edit?type=email" class="utrecht-link utrecht-link--html-a">
                            <span class="utrecht-link-list__link-text">{{#email}}Aanpassen{{/email}}{{^email}}Toevoegen{{/email}}<span class="sr-only"> e-mailadres</span></span>
                        </a>
                    </td>
                </tr>
                <tr class="nijmegen-table__row">
                    <td class="nijmegen-table__data-cell" data-label="Kenmerk">Telefoonnummer</td>
                    <td class="nijmegen-table__data-cell" data-label="Waarde">{{telefoonnummer}}{{^telefoonnummer}}-{{/telefoonnummer}}</td>
                    <td class="nijmegen-table__data-cell" data-label="Actie">
                        <a href="/persoonsgegevens/edit?type=phonenumber" class="utrecht-link utrecht-link--html-a">
                            <span class="utrecht-link-list__link-text">{{#telefoonnummer}}Aanpassen{{/telefoonnummer}}{{^telefoonnummer}}Toevoegen{{/telefoonnummer}}<span class="sr-only"> telefoonnummer</span></span>
                        </a>
                    </td>
                </tr>
            </tbody>
        </table>

    {{/errorContactgegevens}}
    {{#errorContactgegevens}}
        <h2>Er is iets misgegaan</h2>
        <p>{{errorContactgegevens}}</p>
    {{/errorContactgegevens}}
</section>
