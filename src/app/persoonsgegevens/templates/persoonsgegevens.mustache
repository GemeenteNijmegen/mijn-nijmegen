{{>header}}

<main>
    <!-- START: template component(s) -->
    <div class="container">
        <div class="row">
            <nav class="nijmegen-sidenav col-lg-3 col-md-12">
                    <ul class="nijmegen-sidenav__list">
                    {{#nav}}
                        <li class="nijmegen-sidenav__item {{#current}}active{{/current}}">
                            {{{icon}}}
                            <a href="{{{url}}}">{{title}}</a>
                        </li>
                    {{/nav}}
                    </ul>
            </nav>
            <div class="col-lg-9 col-md-12">
                <h1>Mijn gegevens</h1>
                <p class="lead">Hier vindt u een overzicht van uw persoons- en adresgegevens.</p>
                {{^error}}
                <section>
                <h2>Persoonsgegevens</h2>
                <table class="responsive-table">
                    <thead>
                        <tr>
                            <th>Kenmerk</th>
                            <th>Waarde</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>BSN</td>
                            <td>{{persoonsgegevens.bsn}}</td>
                        </tr>

                        {{#persoonsgegevens.naam}}
                        <tr>
                            <td>Naam (aanschijfwijze)</td>
                            <td>{{persoonsgegevens.naam}}</td>
                        </tr>
                        {{/persoonsgegevens.naam}}

                        <tr>
                            <td>Initialen</td>
                            <td>{{persoonsgegevens.voorletters}}</td>
                        </tr>
                        <tr>
                            <td>Voornamen</td>
                            <td>{{persoonsgegevens.voornamen}}</td>
                        </tr>
                        <tr>
                            <td>Voorvoegsel</td>
                            <td>{{persoonsgegevens.voorvoegsel}}</td>
                        </tr>
                        <tr>
                            <td>Geslachtsnaam</td>
                            <td>{{persoonsgegevens.geslachtsnaam}}</td>
                        </tr>

                        {{#persoonsgegevens.achternaam}}
                        <tr>
                            <td>Achternaam</td>
                            <td>{{persoonsgegevens.achternaam}}</td>
                        </tr>
                        {{/persoonsgegevens.achternaam}}

                        <tr>
                            <td>Geboortedatum</td>
                            <td>{{persoonsgegevens.geboortedatum}}</td>
                        </tr>
                        <tr>
                            <td>Nederlandse nationaliteit</td>
                            <td>{{persoonsgegevens.nederlandseNationaliteit}}</td>
                        </tr>
                        <tr>
                            <td>Geslachtsaanduiding</td>
                            <td>{{persoonsgegevens.geslacht}}</td>
                        </tr>
                    </tbody>
                </table>
                </section>
                <section>
                <h2>Adresgegevens</h2>
                <table class="responsive-table">
                    <thead>
                        <tr>
                            <th>Kenmerk</th>
                            <th>Waarde</th>
                        </tr>
                    </thead>
                    <tbody>

                        {{! HaalCentraal has only a formated adres }}
                        {{#persoonsgegevens.adresHaalCentraal}}
                        <tr>
                            <td>Adres</td>
                            <td>{{.}}</td>
                        </tr>
                        {{/persoonsgegevens.adresHaalCentraal}}

                        {{! Old style }}
                        {{^persoonsgegevens.adresHaalCentraal}}
                        <tr>
                            <td>Straat en huisnummer</td>
                            <td>{{persoonsgegevens.straat}} {{persoonsgegevens.huisnummer}}</td>
                        </tr>
                        <tr>
                            <td>Postcode</td>
                            <td>{{persoonsgegevens.postcode}}</td>
                        </tr>
                        <tr>
                            <td>Woonplaats</td>
                            <td>{{persoonsgegevens.woonplaats}}</td>
                        </tr>
                        {{/persoonsgegevens.adresHaalCentraal}}

                    </tbody>
                </table>
                </section>
                {{/error}}
                {{#error}}
                <h2>Er is iets misgegaan</h2>
                <p>{{error}}</p>
                {{/error}}
            </div>
        </div>
    </div>

    <!-- END: template component(s) -->
</main>
{{>footer}}
