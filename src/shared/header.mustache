<!doctype html>
<html lang="nl" dir="ltr" class="nijmegen-spacing">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    {{#xsrf_token}}<meta name="xsrf-token" content="{{ xsrf_token }}">{{/xsrf_token}}
    <link rel="shortcut icon" href="/static/favicon.ico" type="image/x-icon">

    <link rel="stylesheet" href="/static/styles/ds.css">
    <link rel="stylesheet" href="/static/styles/app.css">
    {{{header_additions}}}
    <title>{{#title}}{{.}} - {{/title}}Mijn Nijmegen</title>
</head>
<body data-loaded="{{#timeout}}false{{/timeout}}" class="nijmegen-margin-block-0 nijmegen-margin-inline-0 utrecht-document nijmegen-theme">
<a href="#main" class="nijmegen-skip-link">Ga naar hoofdinhoud</a>
<nijmegen-header>
  <div class="nijmegen-header__content--small">
    <div class="nijmegen-header__content--small--inner">
      {{#shownav}}
      <button
        class="nijmegen-toolbar-button nijmegen-toolbar-button--icon-menu"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Menu openen"
      >Menu</button>
      {{/shownav}}
      <div>
        {{>beeldmerk}}
      </div>
      {{#shownav}}
      <span>{{volledigenaam}}</span>
      {{/shownav}}
    </div>
    {{#shownav}}
    <div id="mobile-menu" class="nijmegen-header__mobile-menu">
      <nijmegen-mobile-menu>
        {{#has_sidenav}}
        <ul class="nijmegen-mobile-menu__list">
          {{#nav}}
            <li>
              <a 
                href="{{{url}}}" 
                target="_self" 
                {{#current}}aria-current="page"{{/current}}
                class="nijmegen-mobile-menu__link nijmegen-mobile-menu__link--strong {{#current}}nijmegen-mobile-menu__link--current{{/current}}"
              >
                <span>
                  {{{icon}}}
                  {{title}}
                </span>
              </a>
            </li>
          {{/nav}}
        </ul>
        <div class="nijmegen-mobile-menu__separator">
          <hr class="utrecht-separator">
        </div>
        {{/has_sidenav}}
        <ul class="nijmegen-mobile-menu__list">
          <li><a href="/uitloggen" class="nijmegen-mobile-menu__link nijmegen-mobile-menu__link--strong">Uitloggen</a></li>
          
          
          <li><a href="https://nijmegen.nl" target="_blank"
              class="nijmegen-mobile-menu__link nijmegen-mobile-menu__link--strong">
              <span>Nijmegen.nl</span> 
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                class="tabler-icon tabler-icon-external-link ">
                <path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6"></path>
                <path d="M11 13l9 -9"></path>
                <path d="M15 4h5v5"></path>
              </svg></a></li>
        </ul>
      </nijmegen-mobile-menu>
    </div>
    {{/shownav}}
  </div>
  <div class="nijmegen-header__content">
    <div class="nijmegen-header__content--inner">
      <div>
        {{>logo}}
      </div>
      <nav></nav>
      {{#shownav}}
      <ul class="nijmegen-header__actions">
        <li class="nijmegen-header-action nijmegen-header-action--relative">
          <button
            class="nijmegen-header-item"
            aria-expanded="false"
            aria-controls="account-panel"
            aria-label="{{volledigenaam}}, accountmenu"
            data-test="account-menu"
          >{{volledigenaam}}</button>
          <div id="account-panel" class="nijmegen-header__panel nijmegen-header__panel--small">
            <div class="nijmegen-dropdown-menu">
              <ul class="nijmegen-dropdown-menu__list" role="list">
                <li>
                  <a href="/logout" class="nijmegen-dropdown-menu__item" data-test="logout-button">Uitloggen</a>
                </li>
                <li>
                  <a href="https://nijmegen.nl" class="nijmegen-dropdown-menu__item">
                    <span>Nijmegen.nl</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="23" height="24" viewBox="0 0 24 24"
                      fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                      class="tabler-icon tabler-icon-external-link ">
                      <path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6"></path>
                      <path d="M11 13l9 -9"></path>
                      <path d="M15 4h5v5"></path>
                    </svg>
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </li>
      </ul>
      {{/shownav}}
    </div>
  </div>
  <div class="nijmegen-header__backdrop"></div>
</nijmegen-header>
{{>breadcrumbs}}
<div class="utrecht-page-body nijmegen-padding-block-start-200 nijmegen-padding-block-end-400">
    <div class="utrecht-page-body__content nijmegen-container-xxl">
      <div class="nijmegen-grid">
      {{#has_sidenav}}
          <div class="mijn-sidenav-wrapper nijmegen-g-col-lg-2 nijmegen-g-start-lg-0 nijmegen-g-col-2">
          {{>sidenav}}
          </div>
          <div class="nijmegen-g-col-lg-9 nijmegen-g-start-lg-4 nijmegen-g-col-12">
      {{/has_sidenav}}
      {{^has_sidenav}}
          <div class="nijmegen-g-col-lg-8 nijmegen-g-start-lg-3 nijmegen-g-col-12">
      {{/has_sidenav}}
