{{>header}}

<main class="denhaag-theme nijmegen-theme">
    <!-- START: template component(s) -->
    <div class="container">
        {{>breadcrumbs}}
        <div class="row">
        {{>sidenav}}
        <div class="col-lg-9 col-md-12">
            <h1>Mijn taken</h1>
            <p class="lead">Bekijk de taken die u nog uit moet voeren.</p>
            <div>
            {{#timeout}}
            <p id="taken-list">Bezig met ophalen van uw open taken… {{>spinner}}</p>
            {{/timeout}}
            {{#has_taken}}
            {{{taken}}}
            {{/has_taken}}
            </div>
        </div>
    </div>

    <!-- END: template component(s) -->
</main>

{{>footer}}
