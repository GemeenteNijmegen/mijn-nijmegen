{{>header}}

<main id="main">
    <h1>{{title}}</h1>

    <p class="utrecht-paragraph utrecht-paragraph--lead">We hebben een verificatiecode gestuurd naar <strong>{{pendingValue}}</strong>.</p>

    {{#error}}
    <p class="utrecht-form-field-error-message" role="alert">{{error}}</p>
    {{/error}}

    <form method="POST" action="/persoonsgegevens/verify" novalidate>
        <input type="hidden" name="xsrf_token" value="{{xsrf_token}}">
        <input type="hidden" name="type" value="{{type}}">

        <div class="utrecht-form-field utrecht-form-field--text">
            <label class="utrecht-form-label utrecht-form-field__label" for="code">Verificatiecode</label>
            <input type="text" id="code" name="code" class="utrecht-textbox utrecht-textbox--html-input utrecht-form-field__input" required pattern="[0-9]{6}" maxlength="6" autocomplete="off" aria-describedby="code-description code-error">
            <p id="code-error" class="utrecht-form-field-error-message utrecht-form-field__error-message" role="alert" hidden>
                <span class="sr-only">Invoer onjuist: </span>Vul een geldige 6-cijferige code in
            </p>
            <p id="code-description" class="utrecht-form-field-description utrecht-form-field__description">Voer de 6-cijferige code in die u heeft ontvangen.</p>
        </div>

        <div class="utrecht-button-group">
            <button type="submit" class="utrecht-button utrecht-button--primary-action">Verifiëren</button>
            <a href="/persoonsgegevens" class="utrecht-button utrecht-button--secondary-action">Annuleren</a>
        </div>
    </form>

    <p class="utrecht-paragraph utrecht-paragraph--small">De code is 15 minuten geldig. U heeft nog {{attemptsLeft}} poging(en) over.</p>
</main>

<script src="/static/js/form-validation.js"></script>
{{>footer}}
