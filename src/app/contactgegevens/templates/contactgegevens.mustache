{{>header}}
<main>
    <!-- START: template component(s) -->
    <div class="container">
        <div class="row">
        <nav class="nijmegen-sidenav col-lg-3 col-md-12">
                <ul class="nijmegen-sidenav__list">
                {{#nav}}
                    <li class="nijmegen-sidenav__item {{#current}}active{{/current}}">
                        {{{icon}}}
                        <a href="{{{url}}}">{{title}}</a>
                    </li>
                {{/nav}}
                </ul>
        </nav>
        <div class="col-lg-9 col-md-12">
                <h1>Mijn contactgegevens</h1>
                <div class="alert alert-info">U kunt uw contactgegevens beheren in Mijn Nijmegen. Houd er rekening mee dat we u in sommige gevallen nog om uw contactgegevens kunnen vragen, omdat deze gegevens nog niet overal volledig worden gebruikt. Uiteindelijk worden de contactgegevens uit Mijn Nijmegen voor al uw online zaken met ons gebruikt, hier werken we aan.</div>
                {{^error}}

                <p class="lead">Hier vindt u een overzicht van uw contactgegevens.</p>

                <ul role="list" class="utrecht-link-list utrecht-link-list--html-ul">
                    <li class="utrecht-link-list__item">
                        <a href="/contactgegevens/edit" class="utrecht-link utrecht-link--html-a utrecht-link-list__link">
                            <span class="utrecht-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="tabler-icon tabler-icon-chevron-right">
                                    <path d="M9 6l6 6l-6 6"></path>
                                </svg>
                            </span>
                            <span class="utrecht-link-list__link-text">Aanpassen</span>
                        </a>
                    </li>
                </ul>

                <table class="responsive-table">
                    <tbody>
                        <tr>
                            <td>E-mailadres</td>
                            <td>{{email}}</td>
                        </tr>
                        <tr>
                            <td>Telefoonnummer</td>
                            <td>{{telefoonnummer}}</td>
                        </tr>
                        <tr>
                            <td>Voorkeurskanaal</td>
                            <td>
                                {{#voorkeurEmail}}E-mail{{/voorkeurEmail}}
                                {{#voorkeurTelefoon}}Telefoon{{/voorkeurTelefoon}}
                            </td>
                        </tr>
                    </tbody>
                </table>


                {{/error}}
                {{#error}}
                    <h2>Er is iets misgegaan</h2>
                    <p>{{error}}</p>
                {{/error}}
            </div>
        </div>
    </div>

    <!-- END: template component(s) -->
</main>
{{>footer}}
