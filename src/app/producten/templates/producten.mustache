{{>header}}

<main id="denhaag-theme">
    <!-- START: template component(s) -->
    <div class="container">
        <div class="row">
            <nav class="nijmegen-sidenav col-lg-3 col-md-12">
                    <ul class="nijmegen-sidenav__list">
                    {{#nav}}
                        <li class="nijmegen-sidenav__item {{#current}}active{{/current}}">
                            {{{icon}}}
                            <a href="{{{url}}}">{{title}}</a>
                        </li>
                    {{/nav}}
                    </ul>
            </nav>
            <div class="col-lg-9 col-md-12">
                <h1>Mijn Producten</h1>
                <p class="lead">Hier vindt u een overzicht van uw producten.</p>
                <div class="alert alert-info">Op dit moment vindt u in Mijn Nijmegen informatie over uw producten en diensten. Het kan dat uw product of dienst niet in dit overzicht staat, nog niet alles wordt hier getoond. Uiteindelijk vindt u in Mijn Nijmegen al uw online producten met ons terug, hier werken we aan.</div>

                <div class="card card-services col-lg-3 col-md-12">
                    <div class="card-body">
                        <h3 class="card-title">Bijstand</h3>
                        <p class="card-text">Bijstand content product met label mijn-omgeving</p>
                    </div>
                </div>   

            </div>
        </div>
    </div>

    <!-- END: template component(s) -->
</main>

{{>footer}}
