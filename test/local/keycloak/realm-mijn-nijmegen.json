      "enabled": true,
      "emailVerified": true,
      "firstName": "H.",
      "lastName": "van Hapert",
      "email": "digid-999998754@example.com",
      "attributes": {},
      "credentials": [
        {
          "type": "password",
          "value": "digid-999998754",
          "temporary": false
        }
      ],
      "requiredActions": []
    },
    {
      "id": "eherkenning-69599084",
      "username": "eherkenning-69599084",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Bedrijf",
      "email": "eherkenning-69599084@example.com",
